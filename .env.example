# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Optional: model override ──────────────────────────────────────────────────
# Default is deepseek-v4-flash.  Do NOT use deepseek-chat or deepseek-reasoner
# (they have been retired).
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Optional: thinking mode (disabled | enabled) ──────────────────────────────
# When enabled the model prefixes its answer with a <think> block.
# Keep "disabled" for faster / cheaper runs.
DEEPSEEK_THINKING=disabled

# ── Optional: web search ──────────────────────────────────────────────────────
# Provide a Tavily key for higher-quality web search results.
# If empty, the agent falls back to DuckDuckGo (no key required).
TAVILY_API_KEY=your_tavily_api_key_here

# ── Optional: output directory ────────────────────────────────────────────────
OUTPUT_DIR=outputs

# ── Optional: max tool-calling iterations ─────────────────────────────────────
MAX_ITERATIONS=6
